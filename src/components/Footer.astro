---
import { Image } from "astro:assets";
import Section from "@/components/Section.astro";
import footerLogo from "@/assets/site/footer-logo.png";
import { links, site } from "@/data/site";

const linkClass = "type-b2 font-bold text-ink underline decoration-1 underline-offset-4";
---

<Section
  as="footer"
  tone="red"
  class="items-center justify-center gap-6 lg:grid lg:grid-cols-[repeat(6,1fr)] lg:items-center"
>
  <Image
    src={footerLogo}
    alt={site.name}
    widths={[480, 960, 1440, 2160]}
    sizes="(min-width: 1440px) 1368px, 100vw"
    class="w-full lg:col-span-6"
  />
  <p class="type-b2">
    <a href={links.contact} class={linkClass}>{site.email}</a>
  </p>
  <p class="type-b2">
    <a href={links.instagram} target="_blank" rel="noopener" class={linkClass}>
      Instagram
    </a>
  </p>
  <div class="order-last lg:order-none lg:col-span-2" aria-hidden="true" />
  <p class="type-b2 text-ink lg:col-span-2">{site.copyright}</p>
</Section>
