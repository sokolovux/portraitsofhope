---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type Props = HTMLAttributes<"section"> & {
  as?: "section" | "footer";
  /** Columns spanned in the 6-column page grid at desktop widths. */
  span?: 2 | 3 | 4 | 6;
  tone?: "ink" | "red";
};

const spans = {
  2: "lg:col-span-2",
  3: "lg:col-span-3",
  4: "lg:col-span-4",
  6: "lg:col-span-6",
};

const { as: Tag = "section", span = 6, tone = "ink", class: className, ...rest } = Astro.props;
---

<Tag
  class={cn(
    "relative flex flex-col items-start justify-start px-4.5 py-9 sm:px-6 md:px-9",
    tone === "red" ? "bg-red" : "bg-ink",
    spans[span],
    className,
  )}
  {...rest}
>
  <slot />
  <div class="pointer-events-none absolute top-0 left-0 size-1.5 bg-line" aria-hidden="true"></div>
</Tag>
