---
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import TeamCard from "@/components/TeamCard.astro";
import { team } from "@/data/site";
---

<Section span={6}>
  <Container class="items-start">
    <div class="flex w-full flex-1 flex-col items-start gap-6">
      <h2 class="type-h4">team</h2>
      <ul class="grid w-full grid-cols-1 gap-2.25 sm:grid-cols-2 md:grid-cols-3">
        {team.map((member) => <TeamCard member={member} />)}
      </ul>
    </div>
  </Container>
</Section>
