---
import { Image } from "astro:assets";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import heroLogo from "@/assets/site/hero-logo.png";
import { site } from "@/data/site";
---

<Section span={4}>
  <Container class="items-start justify-center gap-4 lg:justify-end">
    <h1 class="w-full">
      <Image
        src={heroLogo}
        alt={site.name}
        widths={[480, 960, 1440, 1920]}
        sizes="(min-width: 1440px) 888px, (min-width: 992px) 62vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="w-full"
      />
    </h1>
    <p class="type-h4">An Art project amplifying the voices of political prisoners in Russia</p>
  </Container>
</Section>
