---
import MobileMenu from "@/components/MobileMenu";
import { nav, site } from "@/data/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="sticky top-0 z-10 mx-auto w-full max-w-site bg-ink">
  <div class="relative flex items-center justify-between bg-red px-3 py-1.5 lg:grid lg:grid-cols-6 lg:px-1.5 lg:py-0">
    <a href="/" class="lg:col-span-3" aria-current={currentPath === "/" ? "page" : undefined}>
      <span class="block type-h4 text-ink max-sm:text-[1.5rem]">{site.name}</span>
    </a>

    <nav aria-label="Main" class="hidden self-stretch lg:col-span-3 lg:flex">
      {
        nav.map((item) => (
          <>
            <div class="w-px self-stretch bg-ink" aria-hidden="true" />
            <a
              href={item.href}
              aria-current={item.href === currentPath ? "page" : undefined}
              {...(item.external ? { target: "_blank", rel: "noopener" } : {})}
              class="flex flex-1 items-center justify-center py-3 font-heading text-base leading-none font-bold tracking-[-0.01rem] text-ink uppercase transition-colors duration-200 hover:bg-ink hover:text-red"
            >
              {item.label}
            </a>
          </>
        ))
      }
    </nav>

    <MobileMenu client:media="(width < 62rem)" items={nav} currentPath={currentPath} />
  </div>
</header>
