---
import MobileMenu from "@/components/MobileMenu";
import { nav, site } from "@/data/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  data-nav
  class="sticky top-0 z-10 mx-auto w-full max-w-site bg-ink transition-transform duration-300 ease-in-out data-hidden:-translate-y-full motion-reduce:transition-none"
>
  <div class="relative flex items-center justify-between border border-line bg-ink px-4.5 py-5 sm:px-6 md:px-9 lg:grid lg:grid-cols-6 lg:px-0 lg:py-0">
    <a href="/" class="lg:col-span-3 lg:pl-9" aria-current={currentPath === "/" ? "page" : undefined}>
      <span class="block type-h4 text-red max-sm:text-[1.5rem]">{site.name}</span>
    </a>

    <nav aria-label="Main" class="hidden self-stretch lg:col-span-3 lg:flex">
      {
        nav.map((item) => (
          <>
            <div class="w-px self-stretch bg-line" aria-hidden="true" />
            <a
              href={item.href}
              aria-current={item.href === currentPath ? "page" : undefined}
              {...(item.external ? { target: "_blank", rel: "noopener" } : {})}
              class:list={[
                "flex flex-1 items-center justify-center py-6 font-heading text-base leading-none font-bold tracking-[-0.01rem] uppercase transition-colors duration-200",
                item.highlight ? "bg-red text-ink hover:bg-red-shade" : "text-paper hover:bg-red hover:text-ink",
              ]}
            >
              {item.label}
            </a>
          </>
        ))
      }
    </nav>

    <MobileMenu client:media="(width < 62rem)" items={nav} currentPath={currentPath} />
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-nav]")!;
  const THRESHOLD = 8;
  let lastY = Math.max(0, window.scrollY);
  let ticking = false;

  const show = () => delete header.dataset.hidden;

  const update = () => {
    ticking = false;
    // Clamp iOS overscroll bounce, which reports negative scrollY.
    const y = Math.max(0, window.scrollY);
    const menuOpen = header.querySelector('[aria-expanded="true"]');

    if (y < header.offsetHeight || menuOpen) {
      show();
      lastY = y;
      return;
    }
    if (Math.abs(y - lastY) < THRESHOLD) return;

    if (y > lastY) header.dataset.hidden = "";
    else show();
    lastY = y;
  };

  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    },
    { passive: true },
  );
  header.addEventListener("focusin", show);
</script>
