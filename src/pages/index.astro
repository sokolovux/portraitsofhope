---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/home/Hero.astro";
import PortraitFlipbook from "@/components/home/PortraitFlipbook.astro";
import About from "@/components/home/About.astro";
import Mission from "@/components/home/Mission.astro";
import Stat from "@/components/home/Stat.astro";
import FeaturedCampaigns from "@/components/home/FeaturedCampaigns.astro";
import GalleryMarquee from "@/components/home/GalleryMarquee.astro";
import Team from "@/components/home/Team.astro";
import CallsToAction from "@/components/home/CallsToAction.astro";
import { stats } from "@/data/site";
---

<BaseLayout footer="home">
  <Hero />
  <PortraitFlipbook />
  <About />
  <Mission />
  {stats.map((stat) => <Stat {...stat} />)}
  <FeaturedCampaigns />
  <GalleryMarquee />
  <Team />
  <CallsToAction />
</BaseLayout>
